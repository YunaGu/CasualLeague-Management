/* 标签栏 */
.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #1AAD19;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 30%;
  right: 30%;
  height: 4rpx;
  background: #1AAD19;
  border-radius: 2rpx;
}

/* 轮次标题 */
.round-section {
  margin-bottom: 20rpx;
}

.round-title {
  font-size: 26rpx;
  color: #999;
  font-weight: 500;
  margin-bottom: 10rpx;
  padding-left: 10rpx;
}

/* 比赛项 */
.schedule-match {
  position: relative;
  padding: 14rpx 0 12rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.schedule-match:last-child {
  border-bottom: none;
}

.match-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.team-name {
  flex: 1;
  font-size: 27rpx;
  font-weight: 500;
  color: #333;
}

.team-name.home {
  text-align: right;
  padding-right: 16rpx;
  color: #1565c0;
}

.team-name.away {
  text-align: left;
  padding-left: 16rpx;
  color: #c62828;
}

.score-box {
  min-width: 140rpx;
  text-align: center;
}

.score {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.score.live {
  color: #e53935;
}

.vs {
  font-size: 26rpx;
  color: #ccc;
  font-weight: 500;
}

.match-info {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 6rpx;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  white-space: nowrap;
  word-break: keep-all;
  flex-shrink: 0;
  padding: 8rpx 16rpx;
}

.group-label {
  font-size: 22rpx;
  color: #999;
}

.quick-mode-tag {
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: #fff3e0;
  color: #e65100;
  font-size: 19rpx;
}

.schedule-extra {
  margin-top: 5rpx;
  text-align: center;
  font-size: 22rpx;
  color: #666;
}

.schedule-extra.penalty {
  color: #2e7d32;
  font-weight: 600;
}

.event-preview {
  margin-top: 10rpx;
  padding: 10rpx 14rpx;
  background: #fafafa;
  border-radius: 8rpx;
}

.event-preview-title {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.event-preview-item {
  font-size: 22rpx;
  color: #444;
  line-height: 1.5;
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 4rpx;
}

.event-preview-item:last-child {
  margin-bottom: 0;
}

.event-icon {
  width: 28rpx;
  text-align: center;
}

.event-side {
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.event-side.home {
  color: #1565c0;
  background: #e3f2fd;
}

.event-side.away {
  color: #c62828;
  background: #fce4ec;
}

.event-team {
  color: #333;
}

.event-player {
  color: #666;
}

.event-minute {
  color: #999;
  margin-left: auto;
}

.event-preview-more {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #999;
}

.match-actions {
  margin-top: 8rpx;
  display: flex;
  justify-content: center;
  gap: 10rpx;
}

.action-btn {
  font-size: 21rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

/* 小组赛编号：左上角固定，避免占用主布局高度 */
.match-no {
  position: absolute;
  top: 8rpx;
  left: 6rpx;
  font-size: 24rpx;
  color: #1AAD19;
  font-weight: 600;
  line-height: 1;
}

.action-btn.edit {
  background: #eceff1;
  color: #455a64;
}

.action-btn.start {
  background: #e8f5e9;
  color: #1b5e20;
}

.action-btn.quick {
  background: #fff3e0;
  color: #e65100;
}

.action-btn.finish {
  background: #ffebee;
  color: #b71c1c;
}

.action-btn.reopen {
  background: #fff3e0;
  color: #e65100;
}

.action-btn.supplement {
  background: #e3f2fd;
  color: #1565c0;
}

/* 淘汰赛标签 */
.knockout-label {
  font-size: 24rpx;
  color: #1AAD19;
  font-weight: 600;
  text-align: center;
  margin-bottom: 10rpx;
}

.quick-modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.5);
}

.quick-modal-content {
  width: 100%;
  max-height: 88vh;
  overflow: hidden;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
}

.quick-modal-title {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  color: #333;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.quick-modal-body {
  padding: 32rpx 28rpx 26rpx;
}

.quick-score-board {
  display: flex;
  align-items: flex-end;
  gap: 18rpx;
}

.quick-score-team {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.quick-score-team-name {
  display: block;
  min-height: 72rpx;
  color: #333;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.35;
}

.quick-score-control {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.quick-score-step {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  background: #f5f5f5;
  color: #666;
  font-size: 38rpx;
}

.quick-score-step.plus {
  background: #e8f5e9;
  color: #1AAD19;
}

.quick-score-input {
  width: 82rpx;
  height: 84rpx;
  box-sizing: border-box;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  color: #222;
  font-size: 52rpx;
  font-weight: 700;
  text-align: center;
}

.quick-score-colon {
  padding-bottom: 12rpx;
  color: #999;
  font-size: 44rpx;
}

.quick-points-preview {
  margin-top: 28rpx;
  padding: 16rpx;
  border-radius: 10rpx;
  background: #e8f5e9;
  color: #1b5e20;
  font-size: 24rpx;
  text-align: center;
}

.quick-points-preview.knockout {
  background: #fff8e1;
  color: #795548;
}

.quick-score-help {
  margin-top: 12rpx;
  color: #999;
  font-size: 21rpx;
  text-align: center;
}

.quick-modal-footer {
  display: flex;
  gap: 10rpx;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.quick-footer-button {
  flex: 1;
  height: 72rpx;
  margin: 0;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  font-size: 24rpx;
  line-height: 1.1;
}

.quick-footer-button::after {
  border: none;
}

.quick-footer-button.cancel {
  background: #f5f5f5;
  color: #666;
}

.quick-footer-button.save {
  border: 2rpx solid #1AAD19;
  background: #fff;
  color: #1AAD19;
}

.quick-footer-button.finish {
  border: none;
  background: #ff5722;
  color: #fff;
}
